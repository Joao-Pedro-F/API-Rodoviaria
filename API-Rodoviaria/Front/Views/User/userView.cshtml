@{
    ViewData["Title"] = "Configurações";
    Layout = null;
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Front.styles.css" asp-append-version="true" />
</head>
<body class="d-flex justify-content-center" style="background-color: #eef3f8">

    <div class="card shadow justify-content-center rounded-4 align-self-center" style="height: 600px;  width:800px">
        <div class="text-center mt-5">

            <img src="~/JPLM Files/logoJPLM_PretoTransparente.png" class="mb-4" width="300px" />

            <form class="mt-4 gap-3 d-flex flex-column align-self-center">

                <div class="d-flex flex-column gap-2 align-self-center w-75">
                    <div class="form-floating">
                        <input disabled type="text" class="form-control" id="inputText1" placeholder="Nome de Usuário">
                        <label for="inputText1">Nome de Usuário</label>
                    </div>

                    <div class="form-floating">
                        <input disabled type="text" class="form-control" id="inputText2" placeholder="Tipo de perfil">
                        <label for="inputText2">Tipo de perfil</label>
                    </div>

                    <div class="form-floating">
                        <input type="email" class="form-control" id="inputEmail" placeholder="Email">
                        <label for="inputEmail">Email</label>
                    </div>

                    <div class="form-floating">
                        <input type="text" class="form-control" id="inputEndereco" placeholder="Endereço">
                        <label for="inputEndereco">Endereço</label>
                    </div>

                </div>

                <div class="d-flex flex-row gap-5 align-self-center">
                    <button id="btnLogin" type="button" class="btn btn-danger mt-5">Deletar</button>
                    <div class="d-flex flex-row gap-2">
                        <button id="btnVoltar" type="button" class="btn btn-secondary mt-5 w-100">Voltar</button>
                        <button id="btnLogin" type="button" class="btn btn-success mt-5 w-100">Salvar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div id="toast" class="toast position-fixed fs-5 bottom-0 end-0 m-3" role="alert">
        <div class="toast-body"></div>
    </div>

    <script src="~/js/user/userDelete.js"></script>
    <script src="~/js/user/userUpdate.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/login/login.js" asp-append-version="true"></script>
</body>