@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Front.styles.css" asp-append-version="true" />
</head>
<body class="d-flex justify-content-center" style="background-color: #eef3f8">

    <div class="d-flex card shadow flex-column align-self-center align-items-center rounded-start-4 rounded-end-0" style="background-color: #334433; height: 500px; width: 300px;">
        <img class="p-2 mt-4 img-fluid" style="border-radius: 15px; max-width: 250px; max-height: 110px;" src="~/JPLM Files/logoJPLM_BrancoTransparente.png" />
        <hr class="w-75 mx-auto" style="border-bottom: 5px solid white; border-radius: 30px; opacity: 0.5;" />
    </div>
    <div class="d-flex card shadow p-4 my-4 align-self-center rounded-start-0" style="background-color: #ffffff; border-radius: 15px; height: 500px;  width: 500px;">
        <div class="text-center mt-5">
            <div class="mb-0 text-start">
                <h1>Bem-Vindo de Volta!</h1>
                <span>Acesse sua conta para continuar.</span>
            </div>
            <form class="mt-4 gap-3 d-flex flex-column align-self-center">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="inputNome" placeholder="nome@exemplo.com">
                    <label for="inputNome">Nome</label>
                </div>

                <div class="input-group">
                    <div class="form-floating">
                        <input type="password" class="form-control" id="inputSenha" placeholder="Senha">
                        <label for="inputSenha">Senha</label>
                    </div>
                </div>

                <button id="btnLogin" type="button" class="btn btn-primary mt-5 w-100" asp-action="Index" asp-controller="Home">Entrar</button>
            </form>
            <span>Não tem uma conta? <a asp-action="cadastroView" asp-controller="Login" asp-area="">Cadastrar</a></span>
        </div>
    </div>
    <div id="toast" class="toast position-fixed fs-5 bottom-0 end-0 m-3" role="alert">
        <div class="toast-body"></div>
    </div>

    <script src="~/js/Autenticacao/loginUser.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/login/login.js" asp-append-version="true"></script>
</body>