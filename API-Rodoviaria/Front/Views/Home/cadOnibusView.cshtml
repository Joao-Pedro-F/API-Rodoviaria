@{
    ViewData["Title"] = "Cadastro Ônibus";
}

<div class="d-flex flex-column text-center align-items-center mt-3">
        <h1>Cadastrar Ônibus</h1>

        <form class="w-50 mt-5">
            <div class="mb-3  d-flex flex-column gap-2">
                <div class="form-floating">
                    <input type="text" class="form-control shadow-none" id="inputCNH" />
                    <label for="inputCNH">Placa do Veículo:</label>
                </div>
                <div class="form-floating">
                    <input type="text" class="form-control shadow-none" id="inputNome" />
                    <label for="inputNome">Capacidade do Veículo:</label>
                </div>
                <div class="form-floating">
                    <input type="text" class="form-control shadow-none" id="inputCPF" />
                     <label for="inputCPF">Selecione um Motorista:</label>
                </div>
                <div class="form-floating">
                    <input type="text" class="form-control shadow-none" id="inputCNH" />
                    <label for="inputCNH">Endereço Inicial:</label>
                </div>
                <div class="form-floating">
                    <input type="text" class="form-control shadow-none" id="inputCNH" />
                    <label for="inputCNH">Endereço Final:</label>
                </div>
                <div class="form-floating">
                    <input type="date" class="form-control shadow-none" id="inputCNH" />
                    <label for="inputCNH">Data Saída:</label>
                </div>
                <div class="form-floating">
                    <input type="date" class="form-control shadow-none" id="inputCNH" />
                    <label for="inputCNH">Data Chegada:</label>
                </div>   
            </div>
            <button type="button" class="btn btn-secondary shadow-none w-100">Cadastrar</button>
        </form>
</div>
