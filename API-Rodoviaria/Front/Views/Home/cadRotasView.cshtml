@{
    ViewData["Title"] = "Cadastro Rotas";
}

<div class="d-flex flex-column text-center align-items-center mt-3">
    <h1>Cadastrar Rotas</h1>

    <form class="w-50 mt-5">
        <div class="mb-3  d-flex flex-column gap-2">
            <div class="form-floating">
                <input type="text" class="form-control shadow-none" id="inputEnderecoI" />
                <label for="inputEnderecoI">Endereço Inicial:</label>
            </div>
                
            <div class="form-floating">
                <input type="text" class="form-control shadow-none" id="inputEnderecoF" />
                <label for="inputEnderecoF">Endereço Final:</label>
            </div>
        </div>
        <button type="button" id="btnCadastrar" class="btn btn-secondary shadow-none w-100">Cadastrar</button>

        <div id="toast" class="toast position-fixed bottom-0 fs-5 end-0 m-3" role="alert">
            <div class="toast-body"></div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/cadRotas.js"></script>
}