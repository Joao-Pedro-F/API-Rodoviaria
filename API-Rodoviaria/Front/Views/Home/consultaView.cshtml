@{
    ViewData["Title"] = "Consultar";
}

<div>

    <div>

        <form class="d-flex flex-column mt-2" onsubmit="return false">
            <div class="d-flex flex-row align-items-center justify-content-center gap-3">
                <div class="form-floating" style="width: 35vh">
                    <select class="form-select shadow-none form-select" aria-label="Default select example" id="selectTipo">
                        <option value="Motoristas">Motoristas</option>
                        <option value="Onibus">Ônibus</option>
                        <option value="Rota">Rota</option>
                        <option value="Viagens">Viagens</option>
                    </select>
                    <label>Selecione o que gostaria de consultar:</label>
                </div>

                <div class="form-floating" style="width: 35vh">
                    <input type="number"  min="1" max="100" step="1" value="5" class="form-control shadow-none" id="qtdPag">
                    <label>Quantos elementos por página:</label>
                </div>
                <button id="btnConsultar" style="width: 33vh; height: 7vh" class="btn btn-secondary shadow-none w-25 mt-1" type="button">Consultar</button>
            </div>
        </form>

        <div id="renderTabela" class="mt-4"></div>

        <div id="toast" class="toast position-fixed bottom-0 fs-5 end-0 m-3" role="alert">
            <div class="toast-body"></div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/consulta.js"></script>
}

@section Modals {

    <div class="modal fade" id="modalEditar" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-2">
                <div class="modal-header border-0">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">Editar</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body conteudoViagens justify-content-start">
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalExcluir" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-2">
                <div class="modal-header border-0">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">Excluir</h1>
                    <button type="button" class="btn-close cancelar1" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body d-flex justify-content-start">
                    <p class="fs-5">Tem certeza de que gostaria de excluir??</p>
                </div>
                <div class="border-0 d-flex flex-row p-3 gap-2">
                    <button type="button" class="btn btn-outline-danger confirmar w-100">Sim</button>
                    <button type="button" class="btn btn-outline-success cancelar w-100" data-bs-dismiss="modal" aria-label="Close">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}